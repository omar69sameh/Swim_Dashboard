# mock = services call lib/data directly (default, zero-config dev)
# api = services fetch /api/* BFF routes
NEXT_PUBLIC_DATA_PROVIDER=mock

# Optional: external API gateway base URL (leave empty for same-origin BFF)
NEXT_PUBLIC_API_BASE_URL=

# Future — server-only (BFF route handlers), do NOT prefix with NEXT_PUBLIC_
# SUPABASE_DASHBOARD_URL=
# SUPABASE_DASHBOARD_SERVICE_ROLE_KEY=
# ML_API_URL=
# ML_API_KEY=

# Future — mobile ingestion project (not used by this dashboard)
# SUPABASE_INGESTION_URL=
